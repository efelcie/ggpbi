{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/efelcie/ggpbi/docs/ggpbir.schema.json",
  "title": "ggpbir objects",
  "description": "Schema for the 'objects' section of a ggpbi visual.json in PBIR format.",

  "type": "object",
  "additionalProperties": false,
  "properties": {
    "layer1": { "$ref": "#/$defs/layerArray" },
    "layer2": { "$ref": "#/$defs/layerArray" },
    "layer3": { "$ref": "#/$defs/layerArray" },
    "scaleX": { "$ref": "#/$defs/scaleXArray" },
    "scaleY": { "$ref": "#/$defs/scaleYArray" },
    "legend": { "$ref": "#/$defs/legendArray" },
    "theme":  { "$ref": "#/$defs/themeArray" },
    "boxplot": { "$ref": "#/$defs/boxplotArray" },
    "histogram": { "$ref": "#/$defs/histogramArray" }
  },

  "$defs": {

    "exprValue": {
      "description": "Power BI expression literal: { expr: { Literal: { Value: ... } } }",
      "type": "object",
      "required": ["expr"],
      "additionalProperties": false,
      "properties": {
        "expr": {
          "type": "object",
          "required": ["Literal"],
          "additionalProperties": false,
          "properties": {
            "Literal": {
              "type": "object",
              "required": ["Value"],
              "additionalProperties": false,
              "properties": {
                "Value": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "solidColor": {
      "description": "Power BI solid color: { solid: { color: '#hex' | ThemeDataColor } }",
      "type": "object",
      "required": ["solid"],
      "additionalProperties": false,
      "properties": {
        "solid": {
          "type": "object",
          "required": ["color"],
          "additionalProperties": false,
          "properties": {
            "color": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{3,8}$"
                },
                {
                  "type": "object",
                  "required": ["ThemeDataColor"],
                  "additionalProperties": false,
                  "properties": {
                    "ThemeDataColor": {
                      "type": "object",
                      "required": ["ColorId", "Percent"],
                      "additionalProperties": false,
                      "properties": {
                        "ColorId": { "type": "integer", "minimum": 0 },
                        "Percent": { "type": "number", "minimum": -100, "maximum": 100 }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },

    "colorValue": {
      "description": "Either a solid hex color or a ThemeDataColor reference.",
      "$ref": "#/$defs/solidColor"
    },

    "boolValue": {
      "description": "Boolean property encoded as expr literal ('true' or 'false').",
      "$ref": "#/$defs/exprValue"
    },

    "numericValue": {
      "description": "Numeric property encoded as expr literal (e.g. '0.85', '4').",
      "$ref": "#/$defs/exprValue"
    },

    "enumValue": {
      "description": "Enum property encoded as expr literal with single-quoted string (e.g. \"'point'\").",
      "$ref": "#/$defs/exprValue"
    },

    "textValue": {
      "description": "Text property encoded as expr literal with single-quoted string.",
      "$ref": "#/$defs/exprValue"
    },

    "layerProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":      { "$ref": "#/$defs/boolValue",    "description": "Activate/deactivate layer. Default: true (layer1), false (layer2/3)." },
        "type":         { "$ref": "#/$defs/enumValue",    "description": "Geom type. Values: 'auto','col','bar','point','line','area','text','boxplot','histogram'. Default: 'auto'." },
        "yField":       { "$ref": "#/$defs/enumValue",    "description": "Which Y field this layer uses. Values: 'auto','y1','y2','y3'. Default: 'auto'." },
        "alpha":        { "$ref": "#/$defs/numericValue", "description": "Transparency 0–1. Default: 0.85." },
        "size":         { "$ref": "#/$defs/numericValue", "description": "Point size / line width 1–40. Default: 4." },
        "fill":         { "$ref": "#/$defs/colorValue",   "description": "Override color (ignores aes.color). Default: auto from palette." },
        "lineStyle":    { "$ref": "#/$defs/enumValue",    "description": "Line dash pattern. Values: 'solid','dashed','dotted','dashdot','longdash','twodash'. Default: 'solid'." },
        "position":     { "$ref": "#/$defs/enumValue",    "description": "Position adjustment. Values: 'identity','stack','dodge','dodge2','fill','jitter'. Default: 'identity'." },
        "orientation":  { "$ref": "#/$defs/enumValue",    "description": "Bar orientation. Values: 'x' (vertical), 'y' (horizontal). Default: 'x'." },
        "shape":        { "$ref": "#/$defs/enumValue",    "description": "Point shape. Values: 'circle','square','triangle','diamond','circleOpen','squareOpen','triangleOpen','diamondOpen','circleFilled','squareFilled','triangleFilled','diamondFilled','plus','cross','asterisk','star'. Default: 'circle'." },
        "pointFill":    { "$ref": "#/$defs/colorValue",   "description": "Fill color for border shapes (pch 21–25). Default: auto." },
        "strokeWidth":  { "$ref": "#/$defs/numericValue", "description": "Stroke width 0–10. Default: 0.5." },
        "just":         { "$ref": "#/$defs/numericValue", "description": "Bar alignment 0–1 (0=left, 0.5=center, 1=right). Default: 0.5." },
        "jitterWidth":  { "$ref": "#/$defs/numericValue", "description": "Jitter width 0–2 (fraction of bandwidth). Default: 0.4." },
        "jitterHeight": { "$ref": "#/$defs/numericValue", "description": "Jitter height 0–2. Default: 0." },
        "lineEnd":      { "$ref": "#/$defs/enumValue",    "description": "SVG line cap. Values: 'butt','round','square'. Default: 'butt'." },
        "lineJoin":     { "$ref": "#/$defs/enumValue",    "description": "SVG line join. Values: 'round','miter','bevel'. Default: 'round'." },
        "arrowShow":    { "$ref": "#/$defs/boolValue",    "description": "Show arrowhead. Default: false." },
        "arrowEnds":    { "$ref": "#/$defs/enumValue",    "description": "Arrow position. Values: 'first','last','both'. Default: 'last'." },
        "arrowType":    { "$ref": "#/$defs/enumValue",    "description": "Arrow style. Values: 'open','closed'. Default: 'open'." },
        "arrowLength":  { "$ref": "#/$defs/numericValue", "description": "Arrow length in px 2–30. Default: 8." },
        "arrowAngle":   { "$ref": "#/$defs/numericValue", "description": "Arrow angle in degrees 5–90. Default: 30." }
      }
    },

    "layerArray": {
      "description": "A layer object array (always exactly one element).",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["properties"],
        "additionalProperties": false,
        "properties": {
          "properties": { "$ref": "#/$defs/layerProperties" }
        }
      }
    },

    "scaleXProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type":  { "$ref": "#/$defs/enumValue", "description": "Scale type. Values: 'auto','linear','log','time','ordinal'. Default: 'auto'." },
        "label": { "$ref": "#/$defs/textValue", "description": "Axis title. Default: field name." }
      }
    },

    "scaleYProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type":  { "$ref": "#/$defs/enumValue", "description": "Scale type. Values: 'auto','linear','log','sqrt'. Default: 'auto'." },
        "label": { "$ref": "#/$defs/textValue", "description": "Axis title. Default: field name." }
      }
    },

    "scaleXArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["properties"],
        "additionalProperties": false,
        "properties": {
          "properties": { "$ref": "#/$defs/scaleXProperties" }
        }
      }
    },

    "scaleYArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["properties"],
        "additionalProperties": false,
        "properties": {
          "properties": { "$ref": "#/$defs/scaleYProperties" }
        }
      }
    },

    "legendProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show":     { "$ref": "#/$defs/boolValue", "description": "Show/hide legend. Default: true." },
        "position": { "$ref": "#/$defs/enumValue", "description": "Legend placement. Values: 'right','bottom','top','left'. Default: 'right'." }
      }
    },

    "legendArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["properties"],
        "additionalProperties": false,
        "properties": {
          "properties": { "$ref": "#/$defs/legendProperties" }
        }
      }
    },

    "themeProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panelFill":      { "$ref": "#/$defs/colorValue",   "description": "Plot area background. Default: #EBEBEB." },
        "gridlineColor":  { "$ref": "#/$defs/colorValue",   "description": "Grid line color. Default: #FFFFFF." },
        "ink":            { "$ref": "#/$defs/colorValue",   "description": "Text color (axis labels, titles). Default: #333333." },
        "paper":          { "$ref": "#/$defs/colorValue",   "description": "Outer background (margins). Default: #FFFFFF." },
        "baseSize":       { "$ref": "#/$defs/numericValue", "description": "Base font size 6–24. Default: 11." }
      }
    },

    "themeArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["properties"],
        "additionalProperties": false,
        "properties": {
          "properties": { "$ref": "#/$defs/themeProperties" }
        }
      }
    },

    "boxplotProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coef":          { "$ref": "#/$defs/numericValue", "description": "Whisker length as IQR multiplier 0–100. Default: 1.5." },
        "notch":         { "$ref": "#/$defs/boolValue",    "description": "Notched box (CI around median). Default: false." },
        "notchWidth":    { "$ref": "#/$defs/numericValue", "description": "Notch width relative to box 0.1–1. Default: 0.5." },
        "varWidth":      { "$ref": "#/$defs/boolValue",    "description": "Box width proportional to sqrt(n). Default: false." },
        "stapleWidth":   { "$ref": "#/$defs/numericValue", "description": "Whisker cap width 0–1 (0 = no cap). Default: 0." },
        "fatten":        { "$ref": "#/$defs/numericValue", "description": "Median line thickness multiplier 0.5–10. Default: 2." },
        "boxWidth":      { "$ref": "#/$defs/numericValue", "description": "Box width as fraction of bandwidth 0.1–1. Default: 0.9." },
        "boxFillColor":  { "$ref": "#/$defs/colorValue",   "description": "Box fill color. Default: white." },
        "outlierShow":   { "$ref": "#/$defs/boolValue",    "description": "Show outlier points. Default: true." },
        "outlierSize":   { "$ref": "#/$defs/numericValue", "description": "Outlier point size 0.5–10. Default: 1.5." },
        "outlierShape":  { "$ref": "#/$defs/enumValue",    "description": "Outlier shape. Values: 'circle','square','triangle','diamond','circleOpen','plus','cross'. Default: 'circle'." }
      }
    },

    "boxplotArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["properties"],
        "additionalProperties": false,
        "properties": {
          "properties": { "$ref": "#/$defs/boxplotProperties" }
        }
      }
    },

    "histogramProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bins":          { "$ref": "#/$defs/numericValue", "description": "Number of bins 1–500. Default: 30." },
        "binwidth":      { "$ref": "#/$defs/numericValue", "description": "Bin width in data units (overrides bins; 0 = use bins). Default: 0." },
        "boundary":      { "$ref": "#/$defs/numericValue", "description": "Boundary between two bins (alignment). Default: 0." },
        "closed":        { "$ref": "#/$defs/enumValue",    "description": "Closed side. Values: 'right','left'. Default: 'right'." },
        "pad":           { "$ref": "#/$defs/boolValue",    "description": "Pad with zero-count bins at edges. Default: false." },
        "histFillColor": { "$ref": "#/$defs/colorValue",   "description": "Histogram fill color. Default: auto." },
        "histBorderColor": { "$ref": "#/$defs/colorValue", "description": "Histogram bin border color. Default: auto." },
        "histBorderWidth": { "$ref": "#/$defs/numericValue", "description": "Histogram bin border width 0–10. Default: 0.5." },
        "histBorderStyle": { "$ref": "#/$defs/enumValue", "description": "Histogram bin border line type. Values: 'solid','dashed','dotted','dashdot','longdash','twodash'. Default: 'solid'." },
        "histTransparency": { "$ref": "#/$defs/numericValue", "description": "Histogram transparency percentage 0–100. Default: 0." }
      }
    },

    "histogramArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["properties"],
        "additionalProperties": false,
        "properties": {
          "properties": { "$ref": "#/$defs/histogramProperties" }
        }
      }
    }
  }
}
